# App
NODE_ENV=development
PUBLIC_DEBUG_MODE=true
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

PUBLIC_SITE_TITLE="My Portfolio"
PUBLIC_SITE_DESCRIPTION="Default site description."

# Database
DATABASE_URL=postgres://user:password@localhost:5432/portfolio

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_with_random_min_32_char_secret
JWT_REFRESH_SECRET=replace_with_random_min_32_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW=10m
RATE_LIMIT_LOGIN_MAX=5
LOGIN_LOCKOUT_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=YourName
SMTP_FROM_EMAIL=
TARGET_EMAIL=owner@example.com
